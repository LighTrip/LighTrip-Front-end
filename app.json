{
  "expo": {
    "name": "LighTrip",
    "slug": "LighTrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "lightrip"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lightrip.LighTrip"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lightrip.LighTrip",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-dev-client",
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "js0oliz8v9"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "사진 촬영을 위해 카메라 접근이 필요해요."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withNaverMapsRepository.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7dd5638-9f0d-4f55-95ad-28014023f768"
      }
    }
  }
}
