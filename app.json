{
  "expo": {
    "name": "LighTrip",
    "slug": "LighTrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app.png",
    "scheme": ["lightrip"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/start-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFD"
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lightrip.LighTrip"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.seoyeon.lightrip",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "방문한 장소를 지도와 여행 기록(여권)에 자동으로 저장하기 위해 위치 정보를 사용합니다. 예를 들어 합정역을 방문하여 기록을 작성하면 지도에 불빛으로 표시되고 여권에 기록이 쌓입니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "js0oliz8v9"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "사진 촬영을 위해 카메라 접근이 필요해요."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugin/withNaverMapMaven",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7dd5638-9f0d-4f55-95ad-28014023f768"
      }
    }
  }
}
